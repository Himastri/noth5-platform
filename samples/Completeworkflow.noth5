OPEN DB "D:/NOTH5_EXCLUSIVE/DATA/ACTIVE.db"

LET total = 0
LET score = 78

IF score > 70 THEN
    RENDER SLIDER INSIDE BUBBLE VALUE 85 COLOR "#00ff88" LABEL "Trust Score"
    LET total = total + 10
ELSE
    RENDER RATING INSIDE BUBBLE VALUE 2 LABEL "Low Trust"
ENDIF

FOR user IN users THEN
    IF user == "admin" THEN
        RENDER TABLE INSIDE BUBBLE FROM SELECT id FROM BAYS
    ELSE
        RENDER CARD INSIDE BUBBLE LABEL "User Card"
    ENDIF
ENDFOR

RENDER QR INSIDE BUBBLE VALUE "verify-email"
