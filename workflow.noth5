# NOTH5 longer example - workflow.noth5
VAR name = "ZENA"
VAR bays = ["BAY-A", "BAY-B", "BAY-C"]

CREATE TABLE BAYS (id INT, name TEXT)
INSERT INTO BAYS VALUES (1, "BAY-A")
INSERT INTO BAYS VALUES (2, "BAY-B")
INSERT INTO BAYS VALUES (3, "BAY-C")

SELECT * FROM BAYS

IF name == "ZENA" THEN
    RENDER CHAT BUBBLE "Hi, I am ZENA - Workflow Demo" INSIDE BUBBLE
ELSE
    RENDER CHAT BUBBLE "Hello Guest" INSIDE BUBBLE
END

FOR bay IN bays DO
    RENDER SLIDER INSIDE BUBBLE bay
    RENDER GAUGE INSIDE BUBBLE bay
END

RENDER CHAT BUBBLE "Workflow complete" INSIDE BUBBLE
